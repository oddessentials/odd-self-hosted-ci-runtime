# Copy to .env. Valid CI_PROVIDER values: github, azure-devops
CI_PROVIDER=github

# Optional for either provider
# RUNNER_NAME=oscr-myrepo
# RUNNER_PERSISTENT=false

# GitHub (CI_PROVIDER=github)
# GITHUB_PAT=
# GITHUB_OWNER=
# GITHUB_REPO=              # omit for an organization-level runner
# GITHUB_RUNNER_GROUP=default
# RUNNER_LABELS=linux,docker,self-hosted

# Azure DevOps (CI_PROVIDER=azure-devops)
# ADO_PAT=
# ADO_ORG_URL=https://dev.azure.com/myorg
# ADO_POOL=Default
# ADO_PROJECT=              # omit for an organization-level agent
# AGENT_LABELS=linux,docker,self-hosted
